{
  "name": "refkit-js",
  "version": "0.3.0",
  "description": "Parse, render, format, and edit bibliographies in Node.js and browsers.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter-gy/refkit.git",
    "directory": "packages/refkit-js"
  },
  "homepage": "https://peter-gy.github.io/refkit/get-started",
  "bugs": "https://github.com/peter-gy/refkit/issues",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./refkit.wasm": "./dist/wasm/refkit_js_native_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "prettier --check src/*.ts scripts/*.mjs tests/*.mjs tests/*.ts package.json tsconfig.json",
    "format": "prettier --write src/*.ts scripts/*.mjs tests/*.mjs tests/*.ts package.json tsconfig.json",
    "test": "node --expose-gc --test tests/*.test.mjs",
    "test:browser": "playwright test --config tests/playwright.config.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "node scripts/check-dist.mjs",
    "test:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
